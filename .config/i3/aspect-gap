#!/bin/sh
# Cycle EVERY workspace (existing and future) through three layouts on one key:
#   1) a full-height 4:3 window area pinned to the RIGHT (empty column left)
#   2) the same area pinned to the LEFT (empty column right)
#   3) full width (no gap)
#
# Uses `gaps ... all`, which sets a global default, so the choice applies to
# all current workspaces and is inherited by new ones.
#
# The empty-column width is derived from the OUTPUT width and the workspace
# HEIGHT -- both unaffected by left/right gaps -- so it stays a true 4:3 area
# every press, at any resolution and with any bar height.

# Focused workspace height (stable under L/R gaps) and its output.
read -r H OUT <<EOF
$(i3-msg -t get_workspaces | jq -r '.[] | select(.focused) | "\(.rect.height) \(.output)"')
EOF

# Full width of that output (constant; not reduced by outer gaps).
W=$(i3-msg -t get_outputs | jq -r --arg o "$OUT" '.[] | select(.name == $o) | .rect.width')

# Width of the empty column that leaves a full-height 4:3 window area.
gap=$(( W - H * 4 / 3 ))
[ "$gap" -lt 0 ] && gap=0

state="${XDG_RUNTIME_DIR:-/tmp}/i3-aspect-gap"
# An explicit state (left|right|off) sets it directly; otherwise cycle.
case "$1" in
  left|right|off) next="$1" ;;
  *)
    case "$(cat "$state" 2>/dev/null)" in
      right) next=left ;;
      left)  next=off ;;
      *)     next=right ;;
    esac
    ;;
esac

# Show/hide the per-side conky windows (named conky-left / conky-right in
# common.lua) so the dashboard only appears in the EMPTY column -- never behind
# the (now translucent) windows. picom fades them on map/unmap.
conky_show() { for w in $(xdotool search --class "conky-$1" 2>/dev/null); do xdotool windowmap "$w"; xdotool windowlower "$w"; done; }
conky_hide() { for w in $(xdotool search --class "conky-$1" 2>/dev/null); do xdotool windowunmap "$w"; done; }

case "$next" in
  # window on the right, empty column on the LEFT  -> show the left conky
  right) i3-msg "gaps right all set 0; gaps left all set $gap" >/dev/null
         conky_show left; conky_hide right ;;
  # window on the left, empty column on the RIGHT   -> show the right conky
  left)  i3-msg "gaps left all set 0; gaps right all set $gap" >/dev/null
         conky_show right; conky_hide left ;;
  # full width, no column -> hide both
  off)   i3-msg "gaps left all set 0; gaps right all set 0" >/dev/null
         conky_hide left; conky_hide right ;;
esac

printf '%s' "$next" > "$state"
