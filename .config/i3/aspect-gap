#!/bin/sh
# Cycle the focused i3 workspace through three layouts on one keypress:
#   1) a full-height 4:3 window area pinned to the RIGHT (empty column left)
#   2) the same area pinned to the LEFT (empty column right)
#   3) full width (no gap)
#
# The empty-column width is derived from the OUTPUT width and the workspace
# HEIGHT -- both unaffected by left/right gaps -- so it stays a true 4:3 area
# every press, at any resolution and with any bar height.

# Focused workspace: height (stable under L/R gaps), number, and its output.
read -r H WS OUT <<EOF
$(i3-msg -t get_workspaces | jq -r '.[] | select(.focused) | "\(.rect.height) \(.num) \(.output)"')
EOF

# Full width of that output (constant; not reduced by outer gaps).
W=$(i3-msg -t get_outputs | jq -r --arg o "$OUT" '.[] | select(.name == $o) | .rect.width')

# Width of the empty column that leaves a full-height 4:3 window area.
gap=$(( W - H * 4 / 3 ))
[ "$gap" -lt 0 ] && gap=0

state="${XDG_RUNTIME_DIR:-/tmp}/i3-aspect-gap.${WS}"
case "$(cat "$state" 2>/dev/null)" in
  right) next=left ;;
  left)  next=off ;;
  *)     next=right ;;
esac

case "$next" in
  right) i3-msg "gaps right current set 0; gaps left current set $gap" >/dev/null ;;
  left)  i3-msg "gaps left current set 0; gaps right current set $gap" >/dev/null ;;
  off)   i3-msg "gaps left current set 0; gaps right current set 0" >/dev/null ;;
esac

printf '%s' "$next" > "$state"
