#!/bin/sh
# Common startup, sourced by every start_apps/<hostname>.<user> script:
# daemons that have no systemd unit + per-session X setup.

~/.screenlayout/home.sh &
clipcatd &
redshift-gtk &
"$HOME/.config/wallpaper/grid-wall" &
numlockx &
pasystray &

# Default applications (common for all; web browser per user)
"$HOME/.config/set-default-apps.sh" &

# Compositor (needed for conky translucency) + the conky dashboard sidebars
pgrep -x -u "$(id -u)" picom >/dev/null || picom -b
"$HOME/.config/conky/start-conkys.sh" &

# Session defaults (all users): 4:3 window area on the LEFT + notifications in
# do-not-disturb.
(
    # Wait for polybar to come up, then give it a moment to reserve its top
    # strut, so the 4:3 gap is computed from the USABLE area (matches $mod+a),
    # not the full screen.
    for _ in $(seq 20); do
        pgrep -u "$(id -u)" -x polybar >/dev/null && break
        sleep 0.5
    done
    sleep 2
    "$HOME/.config/i3/aspect-gap" left
    for _ in $(seq 10); do
        dunstctl set-paused true 2>/dev/null && break
        sleep 1
    done
) &

# Terminal at login (both users); honour $TERMINAL, default to alacritty
${TERMINAL:-alacritty} &

# Touchpad tuning (aurora hardware)
xinput set-prop 'SynPS/2 Synaptics TouchPad' 'libinput Accel Speed' 0.7
xinput set-prop 'SynPS/2 Synaptics TouchPad' 'libinput Tapping Enabled' 1

# Custom user fonts
xset +fp /home/$USER/.local/share/fonts
xset fp rehash
