#!/usr/bin/env bash

set -euo pipefail

STATE_DIR="/var/lib/tailscale"

ACTIVE_STATE="$STATE_DIR/tailscaled.state"

WORK_STATE="$STATE_DIR/tailscaled-work.state"
PERSONAL_STATE="$STATE_DIR/tailscaled-personal.state"

usage() {
    echo "Usage:"
    echo "  sudo $0 work"
    echo "  sudo $0 personal"
    exit 1
}

if [[ $EUID -ne 0 ]]; then
    echo "Please run as root (sudo)."
    exit 1
fi

if [[ $# -ne 1 ]]; then
    usage
fi

TARGET="$1"

case "$TARGET" in
    work)
        TARGET_STATE="$WORK_STATE"
        ;;
    personal)
        TARGET_STATE="$PERSONAL_STATE"
        ;;
    *)
        usage
        ;;
esac

if [[ ! -f "$TARGET_STATE" ]]; then
    echo "State file not found:"
    echo "  $TARGET_STATE"
    exit 1
fi

echo "Stopping tailscaled..."
systemctl stop tailscaled

echo "Switching state to: $TARGET"

cp "$TARGET_STATE" "$ACTIVE_STATE"

chown root:root "$ACTIVE_STATE"
chmod 600 "$ACTIVE_STATE"

echo "Starting tailscaled..."
systemctl start tailscaled

sleep 2

echo
echo "Current Tailscale status:"
tailscale status || true

echo
echo "Active profile: $TARGET"
